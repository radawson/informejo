{
  "name": "informejo",
  "description": "Informejo is a platform for creating and managing IT support tickets",
  "version": "1.1.2",
  "private": true,
  "scripts": {
    "dev": "node server.js",
    "build": "next build",
    "start": "NODE_ENV=production node server.js",
    "lint": "eslint .",
    "postinstall": "npx prisma generate",
    "version-major": "npm version major",
    "version-minor": "npm version minor",
    "version-patch": "npm version patch",
    "typecheck": "tsc --noEmit",
    "test": "jest --runInBand"
  },
  "dependencies": {
    "@fullcalendar/react": "^7.1.5",
    "date-fns": "^4.4.0",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "bcryptjs": "^3.0.3",
    "dotenv": "^18.0.10",
    "lucide-react": "^1.74.0",
    "luxon": "^3.7.2",
    "next": "16.4.6",
    "next-auth": "^4.24.15",
    "nodemailer": "^10.6.0",
    "pg": "^8.23.1",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hot-toast": "^2.6.1",
    "rrule": "^2.8.1",
    "socket.io": "^4.8.4",
    "socket.io-client": "^4.8.4",
    "tailwindcss": "^4.3.5",
    "zod": "^4.6.7",
    "temporal-polyfill": "^1.0.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.5",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.12",
    "@types/jest": "^30.0.0",
    "@types/luxon": "^3.7.6",
    "@types/node": "^26",
    "@types/pg": "^8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "^19.3.0",
    "beasties": "0.5.5",
    "eslint": "10.15.0",
    "eslint-config-next": "16.4.6",
    "jest": "^30.5.2",
    "jest-environment-jsdom": "^30.5.2",
    "openapi-typescript-codegen": "^0.31.0",
    "prisma": "^7.10.1",
    "typescript": "~6.0.3"
  },
  "engines": {
    "node": "^22.18.0 || >=24.0.0"
  },
  "allowScripts": {
    "@parcel/watcher@2.6.0": true,
    "@prisma/engines@7.10.1": true,
    "prisma@7.10.1": true,
    "unrs-resolver@1.12.2": true
  },
  "overrides": {
    "next-auth": {
      "nodemailer": "$nodemailer"
    }
  }
}
