# Database - Matches your docker-compose.yml PostgreSQL configuration
DATABASE_URL="postgresql://informejo:Password@localhost:5432/informejo?schema=public"

# NextAuth - Generate a secure secret for production!
NEXTAUTH_URL="http://localhost:3003"
NEXTAUTH_SECRET="openssl rand -base64 32"

# Keycloak OIDC - Update with your Keycloak details
KEYCLOAK_ID="client-id"
KEYCLOAK_SECRET="client-secret-from-keycloak"
KEYCLOAK_ISSUER="https://keycloak.host/realms/my-realm"

# Email (SMTP) - Update with your SMTP server details
SMTP_HOST="localhost"
SMTP_PORT="587"
SMTP_USER="your-email@example.com"
SMTP_PASSWORD="your-password"
SMTP_FROM="IT Support <support@example.com>"

# App Configuration
PORT=3003
NEXT_PUBLIC_APP_URL="http://localhost:3003"

# WebSocket/Socket.IO (optional - defaults to NEXT_PUBLIC_APP_URL)
NEXT_PUBLIC_SOCKET_URL="http://localhost:3003"

# Optional secret for the in-process schedule runner.
# If unset, server.js generates one for the life of the process.
# SCHEDULE_INTERNAL_SECRET="generate-a-long-random-string"

# File uploads are stored in ./uploads under the application directory.
MAX_FILE_SIZE="10485760"